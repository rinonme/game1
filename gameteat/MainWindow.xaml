<Window x:Class="JapanMonopoly.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="櫻花之旅 · 日本環島大富翁"
        Width="1360" Height="900"
        MinWidth="1080" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#F5F1E8"
        FontFamily="Microsoft JhengHei"
        UseLayoutRounding="True">

    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#253B36"/>
        <SolidColorBrush x:Key="Muted" Color="#87918A"/>
        <SolidColorBrush x:Key="Sakura" Color="#E9A9B5"/>
        <SolidColorBrush x:Key="Matcha" Color="#78977A"/>
        <SolidColorBrush x:Key="Cream" Color="#FFFDF7"/>
        <SolidColorBrush x:Key="Gold" Color="#E8BC68"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#405F4D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#587A62"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#F4E9DF"/>
            <Setter Property="Foreground" Value="#405F4D"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#253B36"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 頂部品牌列 -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Border Width="54" Height="54"
                        CornerRadius="18"
                        Background="#F2D5D6"
                        Margin="0,0,14,0">
                    <TextBlock Text="✿"
                               FontSize="34"
                               Foreground="#B66E7C"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SAKURA JOURNEY"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#A56F79"/>
                    <TextBlock Text="櫻花之旅 · 日本環島大富翁"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="#253B36"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="1"
                    Background="#FFFDF7"
                    CornerRadius="15"
                    Padding="18,10"
                    VerticalAlignment="Center"
                    BorderBrush="#E8E0D4"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="CURRENT JOURNEY"
                               FontSize="10"
                               Foreground="#87918A"
                               HorizontalAlignment="Right"/>
                    <TextBlock x:Name="TurnText"
                               Text="第 1 回合"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#405F4D"
                               HorizontalAlignment="Right"/>
                    <TextBlock x:Name="PlayerText"
                               Text="目前玩家：玩家 1"
                               FontSize="12"
                               Foreground="#87918A"
                               HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
        </Grid>
        <!-- 主遊戲區域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- 棋盤卡片 -->
            <Border Grid.Column="0"
                    Background="#FFFDF7"
                    CornerRadius="24"
                    Padding="16"
                    Margin="0,0,20,0"
                    BorderBrush="#E8E0D4"
                    BorderThickness="1">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="8,0,8,12">
                        <StackPanel>
                            <TextBlock Text="YOUR JAPAN ADVENTURE"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#B17A80"/>
                            <TextBlock Text="踏上日本，收集每一段旅程。"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       Foreground="#253B36"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="#F6E8D9"
                                CornerRadius="10"
                                Padding="10,6">
                            <TextBlock Text="✦ 旅行模式"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#9B7450"/>
                        </Border>
                    </Grid>

                    <!-- 程式繪製棋盤的位置 -->
                    <Border Grid.Row="1"
                            Background="#F1F0E5"
                            CornerRadius="18"
                            Padding="8"
                            ClipToBounds="True">
                        <Canvas x:Name="BoardCanvas"
                                Background="#F1F0E5"
                                ClipToBounds="True"/>
                    </Border>

                    <Grid Grid.Row="2" Margin="8,12,8,0">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10"
                                     Fill="#4D8DC8"
                                     Margin="0,0,6,0"/>
                            <TextBlock Text="玩家 1"
                                       Foreground="#52675C"
                                       FontSize="12"
                                       Margin="0,0,16,0"/>

                            <Ellipse Width="10" Height="10"
                                     Fill="#D9788A"
                                     Margin="0,0,6,0"/>
                            <TextBlock Text="玩家 2"
                                       Foreground="#52675C"
                                       FontSize="12"
                                       Margin="0,0,16,0"/>

                            <Ellipse Width="10" Height="10"
                                     Fill="#8B6BB1"
                                     Margin="0,0,6,0"/>
                            <TextBlock Text="玩家 3"
                                       Foreground="#52675C"
                                       FontSize="12"
                                       Margin="0,0,16,0"/>

                            <Ellipse Width="10" Height="10"
                                     Fill="#D49A45"
                                     Margin="0,0,6,0"/>
                            <TextBlock Text="玩家 4"
                                       Foreground="#52675C"
                                       FontSize="12"/>
                        </StackPanel>

                        <TextBlock Text="TOKYO  ·  KYOTO  ·  OSAKA"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#A1A79B"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- 右側資訊面板 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 玩家資產卡 -->
                <Border Grid.Row="0"
                        Background="#405F4D"
                        CornerRadius="22"
                        Padding="21"
                        Margin="0,0,0,14">

                    <Border.Effect>
                        <DropShadowEffect Color="#405F4D"
                                          BlurRadius="18"
                                          ShadowDepth="4"
                                          Opacity="0.12"/>
                    </Border.Effect>

                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="YOUR WALLET"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#D4E1D2"/>
                                <TextBlock Text="旅行資金"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Margin="0,5,0,0"/>
                            </StackPanel>

                            <TextBlock Text="￥"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="#FFF4D7"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock x:Name="MoneyText"
                                   Text="¥ 15,000"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#FFF4D7"
                                   Margin="0,15,0,13"/>

                        <Border Height="1"
                                Background="#6B8674"
                                Margin="0,0,0,12"/>

                        <Grid>
                            <StackPanel>
                                <TextBlock Text="持有土地"
                                           FontSize="11"
                                           Foreground="#D4E1D2"/>
                                <TextBlock x:Name="PropertyText"
                                           Text="0 座城市"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="所在位置"
                                           FontSize="11"
                                           Foreground="#D4E1D2"
                                           HorizontalAlignment="Right"/>
                                <TextBlock x:Name="PositionText"
                                           Text="東京"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Margin="0,4,0,0"
                                           HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <!-- 旅行操作卡 -->
                <Border Grid.Row="1"
                        Background="#FFFDF7"
                        BorderBrush="#E8E0D4"
                        BorderThickness="1"
                        CornerRadius="22"
                        Padding="18"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="旅行行動"
                                   Style="{StaticResource SectionTitle}"/>

                        <Border Background="#F8F0E7"
                                CornerRadius="16"
                                Padding="12"
                                Margin="0,13,0,12">
                            <StackPanel>
                                <TextBlock Text="本回合骰子"
                                           Foreground="#8A9288"
                                           FontSize="11"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="DiceText"
                                           Text="🎲 尚未擲骰"
                                           Foreground="#405F4D"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,4"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="RollButton"
                                Content="🎲  擲骰子・開始旅行"
                                Style="{StaticResource PrimaryButton}"
                                Click="RollButton_Click"/>

                        <Button x:Name="BuyButton"
                                  Content="🏡  購買這座無主城市"
                                Style="{StaticResource SecondaryButton}"
                                Click="BuyButton_Click"
                                IsEnabled="False"/>

                        <Button Content="📖  遊戲規則"
                                Style="{StaticResource SecondaryButton}"
                                Click="RulesButton_Click"/>
                    </StackPanel>
                </Border>

                <!-- 旅途紀錄 -->
                <Border Grid.Row="2"
                        Background="#FFFDF7"
                        BorderBrush="#E8E0D4"
                        BorderThickness="1"
                        CornerRadius="22"
                        Padding="17">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="JOURNEY LOG"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#B17A80"/>
                                <TextBlock Text="旅途紀錄"
                                           Style="{StaticResource SectionTitle}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>

                            <TextBlock Text="✦"
                                       FontSize="22"
                                       Foreground="#D8B56D"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <TextBox x:Name="LogBox"
                                 Grid.Row="1"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="#F8F5ED"
                                 Foreground="#52675C"
                                 BorderThickness="0"
                                 Padding="11"
                                 FontSize="12"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 底部品牌列 -->
        <Grid Grid.Row="2" Margin="4,15,4,0">
            <TextBlock Text="✿  慢慢旅行，成為日本地產大亨。"
                       FontSize="12"
                       Foreground="#87918A"
                       VerticalAlignment="Center"/>

            <TextBlock Text="SAKURA JOURNEY  ·  2D BOARD GAME"
                       FontSize="10"
                       Foreground="#A1A79B"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>